VITE_API_BASE_URL=http://localhost:8000
# Default off: preserve signup while the email Provider is noop/unavailable.
# Enable only after actual email delivery is verified (#494); rebuild the Frontend.
VITE_EMAIL_VERIFICATION_ENABLED=false

# Keep disabled until reproducible approval evidence for the exact terms is linked.
VITE_SIGNUP_TERMS_APPROVED=false

# PUBLIC_TRACK_C. Track C 규칙 기반 복약 지원 흐름의 공개 여부.
# docs/release-gates/post-mvp-1-external-approvals.md의 EXT-MED-001 · EXT-MED-002 ·
# EXT-PRIV-002 · EXT-SAFETY-001 승인과 해당 version 회귀 결과 없이 true로 두지 않는다.
# vite dev 서버에서는 이 값과 무관하게 켜지고, build 산출물에서만 이 값이 적용된다.
VITE_PUBLIC_TRACK_C=false
