{
  "$defs": {
    "ContentArtifact": {
      "additionalProperties": false,
      "properties": {
        "relative_path": {
          "enum": [
            "cases.jsonl",
            "metrics.json",
            "suite-results.json",
            "comparison.json",
            "gate.json",
            "failures.jsonl",
            "report.md"
          ],
          "type": "string"
        },
        "sha256": { "pattern": "^[0-9a-f]{64}$", "type": "string" },
        "size_bytes": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": ["relative_path", "sha256", "size_bytes"],
      "type": "object"
    }
  },
  "$id": "urn:ah05:rag-eval:schema:content-manifest:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_count": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "artifacts": {
      "items": { "$ref": "#/$defs/ContentArtifact" },
      "type": "array"
    },
    "hash_algorithm": { "const": "SHA-256", "type": "string" },
    "manifest_sha256": { "pattern": "^[0-9a-f]{64}$", "type": "string" },
    "run_id": {
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "schema_id": { "const": "rag-eval.content-manifest", "type": "string" },
    "schema_version": { "const": "1.0.0", "type": "string" }
  },
  "required": [
    "schema_id",
    "schema_version",
    "run_id",
    "hash_algorithm",
    "artifacts",
    "artifact_count",
    "manifest_sha256"
  ],
  "type": "object"
}
