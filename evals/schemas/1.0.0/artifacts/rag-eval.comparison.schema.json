{
  "$defs": {
    "ComparisonDecision": {
      "enum": ["IMPROVED", "NON_INFERIOR", "REGRESSED", "INCONCLUSIVE"],
      "type": "string"
    },
    "ControlledVariableCheck": {
      "additionalProperties": false,
      "properties": {
        "baseline_value_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "candidate_value_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "matched": { "type": "boolean" },
        "variable_key": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$",
          "type": "string"
        }
      },
      "required": [
        "variable_key",
        "baseline_value_hash",
        "candidate_value_hash",
        "matched"
      ],
      "type": "object"
    },
    "DecisionStatus": {
      "enum": ["PASS", "FAIL", "INCONCLUSIVE", "N/A"],
      "type": "string"
    },
    "ExecutionStatus": {
      "enum": [
        "NOT_IMPLEMENTED",
        "NOT_EVALUATED",
        "INVALID",
        "ERROR",
        "COMPLETED"
      ],
      "type": "string"
    },
    "Partition": {
      "enum": ["AUTHORING", "DEV", "HOLDOUT", "SAFETY_REGRESSION"],
      "type": "string"
    },
    "ScopeComparison": {
      "additionalProperties": false,
      "properties": {
        "absolute_delta": {
          "anyOf": [
            {
              "pattern": "^(?:0|[1-9][0-9]*|-[1-9][0-9]*|(?:0|[1-9][0-9]*|-(?:0|[1-9][0-9]*))\\.[0-9]*[1-9])$",
              "type": "string"
            },
            { "type": "null" }
          ]
        },
        "baseline_value": {
          "anyOf": [
            {
              "pattern": "^(?:0|[1-9][0-9]*|-[1-9][0-9]*|(?:0|[1-9][0-9]*|-(?:0|[1-9][0-9]*))\\.[0-9]*[1-9])$",
              "type": "string"
            },
            { "type": "null" }
          ]
        },
        "candidate_value": {
          "anyOf": [
            {
              "pattern": "^(?:0|[1-9][0-9]*|-[1-9][0-9]*|(?:0|[1-9][0-9]*|-(?:0|[1-9][0-9]*))\\.[0-9]*[1-9])$",
              "type": "string"
            },
            { "type": "null" }
          ]
        },
        "comparison_decision": { "$ref": "#/$defs/ComparisonDecision" },
        "metric_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$",
          "type": "string"
        },
        "p_value": {
          "anyOf": [
            {
              "pattern": "^(?:0|[1-9][0-9]*|-[1-9][0-9]*|(?:0|[1-9][0-9]*|-(?:0|[1-9][0-9]*))\\.[0-9]*[1-9])$",
              "type": "string"
            },
            { "type": "null" }
          ]
        },
        "paired_test_method": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$",
              "type": "string"
            },
            { "type": "null" }
          ]
        },
        "partition": { "$ref": "#/$defs/Partition" },
        "relative_delta": {
          "anyOf": [
            {
              "pattern": "^(?:0|[1-9][0-9]*|-[1-9][0-9]*|(?:0|[1-9][0-9]*|-(?:0|[1-9][0-9]*))\\.[0-9]*[1-9])$",
              "type": "string"
            },
            { "type": "null" }
          ]
        },
        "slice_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$",
          "type": "string"
        }
      },
      "required": [
        "metric_id",
        "partition",
        "slice_id",
        "baseline_value",
        "candidate_value",
        "absolute_delta",
        "relative_delta",
        "paired_test_method",
        "p_value",
        "comparison_decision"
      ],
      "type": "object"
    }
  },
  "$id": "urn:ah05:rag-eval:schema:comparison:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "else": { "properties": { "decision_status": { "type": "null" } } },
      "if": {
        "properties": { "execution_status": { "const": "COMPLETED" } },
        "required": ["execution_status"]
      },
      "then": {
        "properties": { "decision_status": { "not": { "type": "null" } } }
      }
    },
    {
      "if": {
        "anyOf": [
          {
            "properties": {
              "controlled_variable_checks": {
                "contains": {
                  "properties": { "matched": { "const": false } },
                  "required": ["matched"]
                }
              }
            },
            "required": ["controlled_variable_checks"]
          },
          {
            "properties": { "controlled_variable_checks": { "maxItems": 0 } },
            "required": ["controlled_variable_checks"]
          },
          {
            "properties": { "scope_comparisons": { "maxItems": 0 } },
            "required": ["scope_comparisons"]
          }
        ]
      },
      "then": {
        "properties": {
          "decision_status": { "type": "null" },
          "execution_status": { "const": "INVALID" }
        }
      }
    },
    {
      "if": {
        "allOf": [
          {
            "properties": {
              "controlled_variable_checks": {
                "not": {
                  "contains": {
                    "properties": { "matched": { "const": false } },
                    "required": ["matched"]
                  }
                }
              }
            },
            "required": ["controlled_variable_checks"]
          },
          {
            "properties": { "execution_status": { "const": "COMPLETED" } },
            "required": ["execution_status"]
          },
          {
            "properties": {
              "scope_comparisons": {
                "contains": {
                  "properties": {
                    "comparison_decision": { "const": "REGRESSED" }
                  },
                  "required": ["comparison_decision"]
                }
              }
            },
            "required": ["scope_comparisons"]
          }
        ]
      },
      "then": { "properties": { "decision_status": { "const": "FAIL" } } }
    },
    {
      "if": {
        "allOf": [
          {
            "properties": {
              "controlled_variable_checks": {
                "not": {
                  "contains": {
                    "properties": { "matched": { "const": false } },
                    "required": ["matched"]
                  }
                }
              }
            },
            "required": ["controlled_variable_checks"]
          },
          {
            "properties": { "execution_status": { "const": "COMPLETED" } },
            "required": ["execution_status"]
          },
          {
            "properties": {
              "scope_comparisons": {
                "not": {
                  "contains": {
                    "properties": {
                      "comparison_decision": { "const": "REGRESSED" }
                    },
                    "required": ["comparison_decision"]
                  }
                }
              }
            },
            "required": ["scope_comparisons"]
          },
          {
            "properties": {
              "scope_comparisons": {
                "contains": {
                  "properties": {
                    "comparison_decision": { "const": "INCONCLUSIVE" }
                  },
                  "required": ["comparison_decision"]
                }
              }
            },
            "required": ["scope_comparisons"]
          }
        ]
      },
      "then": {
        "properties": { "decision_status": { "const": "INCONCLUSIVE" } }
      }
    },
    {
      "if": {
        "allOf": [
          {
            "properties": {
              "controlled_variable_checks": {
                "not": {
                  "contains": {
                    "properties": { "matched": { "const": false } },
                    "required": ["matched"]
                  }
                }
              }
            },
            "required": ["controlled_variable_checks"]
          },
          {
            "properties": { "execution_status": { "const": "COMPLETED" } },
            "required": ["execution_status"]
          },
          {
            "properties": {
              "scope_comparisons": {
                "not": {
                  "contains": {
                    "properties": {
                      "comparison_decision": { "const": "REGRESSED" }
                    },
                    "required": ["comparison_decision"]
                  }
                }
              }
            },
            "required": ["scope_comparisons"]
          },
          {
            "properties": {
              "scope_comparisons": {
                "not": {
                  "contains": {
                    "properties": {
                      "comparison_decision": { "const": "INCONCLUSIVE" }
                    },
                    "required": ["comparison_decision"]
                  }
                }
              }
            },
            "required": ["scope_comparisons"]
          }
        ]
      },
      "then": { "properties": { "decision_status": { "const": "PASS" } } }
    }
  ],
  "properties": {
    "baseline_run_hash": { "pattern": "^[0-9a-f]{64}$", "type": "string" },
    "baseline_run_id": {
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "candidate_run_hash": { "pattern": "^[0-9a-f]{64}$", "type": "string" },
    "candidate_run_id": {
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "controlled_variable_checks": {
      "items": { "$ref": "#/$defs/ControlledVariableCheck" },
      "type": "array"
    },
    "decision_status": {
      "anyOf": [{ "$ref": "#/$defs/DecisionStatus" }, { "type": "null" }]
    },
    "execution_status": { "$ref": "#/$defs/ExecutionStatus" },
    "experiment_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$",
      "type": "string"
    },
    "run_id": {
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "schema_id": { "const": "rag-eval.comparison", "type": "string" },
    "schema_version": { "const": "1.0.0", "type": "string" },
    "scope_comparisons": {
      "items": { "$ref": "#/$defs/ScopeComparison" },
      "type": "array"
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "run_id",
    "experiment_id",
    "baseline_run_id",
    "baseline_run_hash",
    "candidate_run_id",
    "candidate_run_hash",
    "controlled_variable_checks",
    "scope_comparisons",
    "execution_status",
    "decision_status"
  ],
  "type": "object"
}
