          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$",
          "type": "string"
        },
        "evidence_ref_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$",
          "type": "string"
        },
        "locator": { "minLength": 1, "type": "string" }
      },
      "required": ["claim_id", "evidence_ref_id", "locator"],
      "type": "object"
    },
    "ExternalMedicalReviewStatus": {
      "enum": ["NOT_REQUESTED", "PENDING", "APPROVED", "REJECTED"],
      "type": "string"
    },
    "FallbackCode": {
      "enum": [
        "NO_APPROVED_EVIDENCE",
        "CONFLICTING_EVIDENCE",
        "SAFETY_ROUTED",
        "PROVIDER_TIMEOUT",
        "DEPENDENCY_UNAVAILABLE",
        "VALIDATION_FAILED",
        "PRESCRIPTION_STALE",
        "UNSUPPORTED_REQUEST"
      ],
      "type": "string"
    },
    "ForbiddenClaim": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$",
          "type": "string"
        },
        "criticality": { "$ref": "#/$defs/Criticality" },
        "reason_code": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$",
          "type": "string"
        },
        "semantic_rule": { "maxLength": 1000, "minLength": 1, "type": "string" }
      },
      "required": ["claim_id", "semantic_rule", "criticality", "reason_code"],
      "type": "object"
    },
    "GoldClaim": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$",
          "type": "string"
        },
        "claim_text": { "maxLength": 2000, "minLength": 1, "type": "string" },
        "criticality": { "$ref": "#/$defs/Criticality" },
        "required": { "type": "boolean" },
        "supporting_evidence_ref_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$",
            "type": "string"
