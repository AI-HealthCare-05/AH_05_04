      "type": "object"
    },
    "ImmutableReference": {
      "additionalProperties": false,
      "properties": {
        "hash": { "pattern": "^[0-9a-f]{64}$", "type": "string" },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$",
