        "schema_id": { "const": "rag-eval.case", "type": "string" },
        "schema_version": { "const": "1.0.0", "type": "string" },
        "slice_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$",
            "type": "string"
          },
          "type": "array"
        },
        "tags": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$",
            "type": "string"
          },
          "type": "array"
        },
        "task_type": { "const": "ANSWER_GROUNDING", "type": "string" }
      },
