        "schema_id",
        "schema_version",
        "case_id",
        "dataset_code",
        "dataset_version",
        "task_type",
        "partition",
        "slice_ids",
        "data_classification",
        "query",
        "context",
        "input_sha256",
        "leakage_group_ids",
        "critical_claim_rubric_ref",
        "gold_version",
        "review_provenance",
        "tags",
