# 이 파일은 AWS 무료 EC2 내부 Staging용 예시입니다.
# 실제 값은 envs/.staging.env에 작성하고 커밋하지 않습니다.

# Local build/push와 EC2 접속
DOCKER_USER=replace-with-docker-hub-user
DOCKER_REPOSITORY=replace-with-image-repository
APP_VERSION=replace-with-immutable-app-version
FRONTEND_VERSION=replace-with-immutable-frontend-version
STAGING_EC2_HOST=replace-with-ec2-public-ip-or-hostname
STAGING_SSH_KEY_PATH=replace-with-absolute-path-to-pem-key
STAGING_PUBLIC_ORIGIN=http://replace-with-ec2-public-ip-or-hostname

# Application
ENV=staging
SECRET_KEY=replace-with-random-staging-secret-at-least-32-characters
IDEMPOTENCY_HMAC_KEY=replace-with-random-staging-idempotency-key-at-least-32-characters
TIMEZONE=Asia/Seoul
# 비워 두면 Backend hostname 기준 host-only cookie를 사용합니다.
COOKIE_DOMAIN=
CORS_ALLOWED_ORIGINS=http://replace-with-ec2-public-ip-or-hostname

# PostgreSQL: 세 역할은 서로 다른 이름과 비밀번호를 사용합니다.
DB_NAME=finalproject_staging
DB_ADMIN_USER=replace_with_staging_admin_user
DB_ADMIN_PASSWORD=replace-with-staging-admin-password
DB_MIGRATION_USER=replace_with_staging_migration_user
DB_MIGRATION_PASSWORD=replace-with-staging-migration-password
DB_APP_USER=replace_with_staging_app_user
DB_APP_PASSWORD=replace-with-staging-app-password
DB_CONNECT_TIMEOUT=5
DB_CONNECTION_POOL_MAXSIZE=5

# OpenAI - 합성 데이터 내부 Staging 검증에 승인된 자격 증명만 사용합니다.
OPENAI_API_KEY=replace-with-staging-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=20

# CLOVA OCR - 실제 환자·처방 데이터는 사용하지 않습니다.
CLOVA_OCR_INVOKE_URL=https://replace-with-staging-clova-endpoint.example
CLOVA_OCR_SECRET=replace-with-staging-clova-secret
CLOVA_OCR_TIMEOUT_SECONDS=20
OCR_STRUCTURE_LLM_ENABLED=false
OCR_STRUCTURE_MODEL=gpt-4o-mini
OCR_STRUCTURE_TIMEOUT_SECONDS=30
OCR_REQUEST_DEADLINE_SECONDS=60
OCR_RESPONSE_MARGIN_SECONDS=5
OCR_LOCAL_PROCESSING_RESERVE_SECONDS=3
OCR_PENDING_ACTIVE_WINDOW_SECONDS=300
