# ============================================================
# Docker image
# ============================================================

DOCKER_USER=replace-with-production-registry-user
DOCKER_REPOSITORY=replace-with-production-image-repository

# 동일한 Frontend 이미지를 식별할 수 있는 고정 version 또는 commit SHA를 사용합니다.
FRONTEND_VERSION=replace-with-immutable-frontend-version

# Frontend build-time flags. Changing these requires rebuilding the Frontend image.
# PM-approved 30-day demo: 2026-09-17 through 2026-10-16 KST.
# See docs/governance/decisions/2026-09-17-signup-demo-approval.md.
# Set false and rebuild when the demo ends (2026-10-17 00:00 KST).
VITE_SIGNUP_TERMS_APPROVED=true
# Enable only after real email delivery is verified; align with the Backend signup gate.
VITE_EMAIL_VERIFICATION_ENABLED=false
# PUBLIC_TRACK_C. EXT-MED-001 · EXT-MED-002 · EXT-PRIV-002 · EXT-SAFETY-001이 모두 Pending인 동안 false.
# 해제 조건은 docs/release-gates/post-mvp-1-external-approvals.md의 "Flag 해제 조건"을 따른다.
VITE_PUBLIC_TRACK_C=false

# 별도 구매 도메인 없이 CloudFront 기본 주소를 사용하는 데모의 기본값입니다.
# 소유 도메인 + Certbot 경로를 사용할 때만 TLS_TERMINATION=certbot으로 변경합니다.
TLS_TERMINATION=cloudfront
PRODUCTION_DOMAIN=replace-with-distribution-id.cloudfront.net
PRODUCTION_PUBLIC_ORIGIN=https://replace-with-distribution-id.cloudfront.net

# CloudFront origin 설정의 X-Origin-Verify custom header와 같은 32자 이상 secret입니다.
CLOUDFRONT_ORIGIN_VERIFY_SECRET=replace-with-random-cloudfront-origin-secret-at-least-32-characters

# TLS_TERMINATION=certbot인 경우에만 입력합니다.
CERTBOT_EMAIL=


# ============================================================
# FastAPI
# ============================================================

ENV=production

# 동일한 이미지를 식별할 수 있는 고정 version 또는 commit SHA를 사용합니다.
APP_VERSION=replace-with-immutable-production-version

# 실제 값은 배포 환경의 Secret으로 관리합니다.
SECRET_KEY=replace-with-random-production-secret-at-least-32-characters

# idempotency-v1.md: 여러 Backend 인스턴스와 재시작 사이에서 반드시 같은 값이어야 합니다.
# 누락·공백이거나 config.py의 placeholder 기본값이면 기동이 거부됩니다.
IDEMPOTENCY_HMAC_KEY=replace-with-random-production-idempotency-hmac-key-at-least-32-characters
IDEMPOTENCY_HMAC_KEY_VERSION=v1
# JSON object: {"old-version":"old-secret"}. key rotation TTL 동안만 이전 key를 보존합니다.
IDEMPOTENCY_HMAC_RETIRED_KEYS={}

# SYNC_MUTATION response_body_snapshot 암호화 키(Fernet, 32byte urlsafe-base64). 아래 값은
# config.py의 placeholder 기본값과 동일해 config.py의 validator가 기동을 거부합니다.
# `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`로
# 생성한 실제 값으로 교체해야 합니다. 알고리즘·키 관리 방식은 아직 Privacy·Security 리뷰
# 대상입니다(#311) — 리뷰 전에는 이 값을 실제 운영 secret으로 확정하지 않습니다.
IDEMPOTENCY_SNAPSHOT_ENCRYPTION_KEY=MDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDA=

# 위 key와 반드시 함께 관리하는 버전 식별자입니다. key만 교체하고 이 값을 그대로 두면 활성
# version이 아래 RETIRED_KEYS에 넣은 구 key의 version과 같아져 기동이 거부됩니다(같은 version
# 문자열에 다른 key가 배포되는 모호한 구성을 막는 안전장치). key를 교체할 때는 반드시 이 값도
# 예를 들어 v2, v3처럼 함께 올리고, 교체 전 key를 아래 RETIRED_KEYS에 원래 version과 함께
# 남겨야 TTL이 남은 기존 snapshot을 계속 복호화할 수 있습니다.
IDEMPOTENCY_SNAPSHOT_ENCRYPTION_KEY_VERSION=v1

# 위 key/version을 교체할 때, TTL(IDEMPOTENCY_RECORD_TTL_DAYS)이 아직 안 지난 기존 snapshot을
# 계속 복호화(replay)하려면 이전 key를 `{"버전": "key"}` JSON으로 여기 남겨둡니다. 새 쓰기에는
# 절대 쓰이지 않고 복호화 전용입니다. 해당 레코드가 전부 만료된 뒤에 이 항목을 지웁니다. 비어
# 있어도 되며, 위 IDEMPOTENCY_SNAPSHOT_ENCRYPTION_KEY_VERSION과 같은 버전 문자열을 쓰면 기동이
# 거부됩니다.
IDEMPOTENCY_SNAPSHOT_ENCRYPTION_RETIRED_KEYS={}

COOKIE_DOMAIN=replace-with-distribution-id.cloudfront.net
TIMEZONE=Asia/Seoul

# 실제 배포 Frontend origin으로 교체합니다.
# 여러 origin은 쉼표로 구분합니다.
CORS_ALLOWED_ORIGINS=https://replace-with-distribution-id.cloudfront.net

# 운영 업로드 파일은 Production Compose의 media_volume 아래에 저장합니다.
STORAGE_DIR=/app/media/medical_documents
# ============================================================
# Web Push
# ============================================================

# 기본값은 false입니다. Production에서 실제 알림 등록·발송을 열려면 두 값을 모두 true로 설정하고
# API와 notification-scheduler 인스턴스를 재시작해야 합니다.
WEB_PUSH_ENABLED=false
WEB_PUSH_PRODUCTION_ENABLED=false
# JSON array. 예: ["fcm.googleapis.com"] — wildcard, scheme, path 금지.
WEB_PUSH_ALLOWED_HOSTS=[]
# 실제 VAPID/암호화/HMAC 값은 배포 Secret으로 관리하고 저장소에 기록하지 않습니다.
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:replace-with-production-contact@example.com
WEB_PUSH_ENCRYPTION_KEYS={}
WEB_PUSH_ACTIVE_KEY_ID=
WEB_PUSH_ENDPOINT_HMAC_KEY=

# ============================================================
# AI Worker
# ============================================================

AI_WORKER_VERSION=replace-with-immutable-worker-version


# ============================================================
# PostgreSQL
# 이 파일은 서버에서 Docker Compose 변수 치환에 사용합니다.
# 각 컨테이너에는 docker-compose.prod.yml의 environment allowlist에
# 명시된 값만 주입하며 이 파일 전체를 env_file로 전달하지 않습니다.
# ============================================================

# PostgreSQL 접속 정보
DB_HOST=postgres
DB_PORT=5432
DB_EXPOSE_PORT=5432
DB_NAME=replace_with_production_db_name

# PostgreSQL 초기화 및 역할 생성 전용 관리자
# FastAPI, Worker, Alembic에는 주입하지 않습니다.
DB_ADMIN_USER=replace_with_production_admin_user
DB_ADMIN_PASSWORD=replace-with-production-admin-password

# Alembic schema migration 전용 계정
DB_MIGRATION_USER=replace_with_production_migration_user
DB_MIGRATION_PASSWORD=replace-with-production-migration-password

# FastAPI와 Worker의 Runtime 전용 계정 (Source는 읽기 전용)
DB_APP_USER=replace_with_production_app_user
DB_APP_PASSWORD=replace-with-production-app-password

# 별도 Source 관리 작업 전용. 일반 FastAPI/Worker에는 주입하지 않습니다.
SOURCE_WRITER_USER=replace_with_production_source_writer
SOURCE_WRITER_PASSWORD=replace-with-production-source-writer-password
SOURCE_WRITER_ACTOR=replace-with-verified-operator-id

# Knowledge Evidence Index 빌드 전용 로그인. Retrieval 연결 전까지 비워 둘 수 있습니다.
# 활성화할 때는 Admin/Migration/Runtime/Source Writer와 다른 NOSUPERUSER 계정을 사용합니다.
KNOWLEDGE_INDEX_BUILDER_USER=
KNOWLEDGE_INDEX_BUILDER_PASSWORD=

# 회원탈퇴 cleanup 전용 DB 역할. 일반 Runtime(DB_APP_USER)에 이력 테이블 DELETE를 열지 않기 위한 선택 role입니다.
# 합성 데이터 기반 데모에서 ACCOUNT_WITHDRAWAL_REQUEST_ENABLED=true로 열 때 FastAPI에 함께 주입합니다.
ACCOUNT_WITHDRAWAL_CLEANUP_DB_ROLE=
ACCOUNT_WITHDRAWAL_CLEANUP_DB_PASSWORD=


# ============================================================
# Redis
# ============================================================

# 운영 Redis는 host port에 공개하지 않고 Docker 내부 network에서 접근합니다.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-production-redis-password
REDIS_STREAM_NAME=oryak:jobs
REDIS_DLQ_STREAM_NAME=oryak:jobs:dead-letter
REDIS_CONSUMER_GROUP=ai-workers
REDIS_CONSUMER_NAME=ai-worker-prod
RECONCILER_CONSUMER_NAME=ai-worker-reconciler
REDIS_BLOCK_MS=5000


# ============================================================
# OpenAI - Guide / Chat
# ============================================================

# 실제 API Key는 배포 Secret에서 주입합니다.
OPENAI_API_KEY=replace-with-production-openai-api-key

OPENAI_MODEL=gpt-4o
OPENAI_TIMEOUT_SECONDS=20
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSION=1536
OPENAI_EMBEDDING_TIMEOUT_SECONDS=20


# ============================================================
# CLOVA OCR
# ============================================================

# 실제 endpoint는 배포 Secret 또는 보호된 환경변수로 관리합니다.
CLOVA_OCR_INVOKE_URL=https://replace-with-production-clova-endpoint.example

# 실제 Secret은 배포 Secret에서 주입합니다.
CLOVA_OCR_SECRET=replace-with-production-clova-secret

CLOVA_OCR_TIMEOUT_SECONDS=20
# 정책 책임자가 승인한 OCR 고지 버전을 Backend와 Worker에 함께 전달합니다.
# 승인 전에는 비워 두어 동의 등록과 외부 OCR 접수를 차단합니다.
OCR_CONSENT_POLICY_VERSION=
# 외부 AI 데이터 전송 승인 전에는 false를 유지합니다.
OCR_STRUCTURE_LLM_ENABLED=false
OCR_STRUCTURE_MODEL=gpt-4o-mini
OCR_STRUCTURE_TIMEOUT_SECONDS=30

# RAG-11 UI·RAG-12 Preflight·E2E·외부 승인 전에는 false를 유지합니다.
PUBLIC_TRACK_F_ENABLED=false

# 회원탈퇴 요청 API 공개 gate. 실제 사용자 대상 Production 공개 승인 전에는 false를 유지합니다.
# 합성 데이터 기반 데모에서만 true로 설정하고, cleanup 전용 DB role/password와 함께 배포합니다.
ACCOUNT_WITHDRAWAL_REQUEST_ENABLED=false

# Opt-in Source/Catalog management profile; never inject into fastapi/ai-worker.
SOURCE_MANAGEMENT_USER=
SOURCE_MANAGEMENT_PASSWORD=

# Protected Retrieval remains blocked until its independent environment authorization is recorded.
PROTECTED_RETRIEVAL_ENABLED=false

# Optional Catalog cutover login, provisioned separately. Keep its password in the isolated Writer environment.
CATALOG_WRITER_USER=
CATALOG_WRITER_PASSWORD=

# Optional Candidate Index Builder login, provisioned separately. Keep its password in the isolated Builder environment.
CANDIDATE_INDEX_BUILDER_USER=
CANDIDATE_INDEX_BUILDER_PASSWORD=

# Source artifact storage는 기본 비활성입니다. Source Snapshot 인계 환경에서는
# S3_PRIVATE를 우선 사용하고, 실제 bucket/credential은 배포 Secret 또는 실행 역할로 주입합니다.
SOURCE_ARTIFACT_STORAGE_BACKEND=DISABLED
SOURCE_ARTIFACT_S3_PREFIX=source-artifacts
# 아래 키는 LOCAL_PRIVATE / S3_PRIVATE를 명시할 때만 채웁니다.
# 빈 문자열은 None이 아니라 ""로 들어가 Config 검증을 깨뜨립니다.
#SOURCE_ARTIFACT_LOCAL_ROOT=
#SOURCE_ARTIFACT_READER_ROOT=
#SOURCE_ARTIFACT_FINALIZER_COMMAND=
#SOURCE_ARTIFACT_FINALIZER_STAGING_ROOT=
#SOURCE_ARTIFACT_S3_BUCKET=replace-with-private-source-artifact-bucket
#SOURCE_ARTIFACT_S3_REGION=replace-with-source-artifact-region
#SOURCE_ARTIFACT_S3_ENDPOINT_URL=
#SOURCE_ARTIFACT_S3_SERVER_SIDE_ENCRYPTION=AES256
#SOURCE_ARTIFACT_S3_KMS_KEY_ID=

# ============================================================
# Email delivery
# ============================================================

# Production/Staging 이메일 발송은 SMTP Provider를 사용합니다. 실제 값은 배포 Secret으로 주입합니다.
# noop은 local/test 전용 기본값이며, 운영 발송을 검증할 때는 smtp와 아래 값을 모두 설정합니다.
EMAIL_PROVIDER=smtp
# Frontend 인증 UI와 운영 발송 경계가 승인된 환경에서만 true로 전환합니다.
SIGNUP_EMAIL_VERIFICATION_REQUIRED=false
SMTP_HOST=replace-with-production-smtp-host
SMTP_PORT=587
SMTP_USERNAME=replace-with-production-smtp-username
SMTP_PASSWORD=replace-with-production-smtp-password
SMTP_FROM_EMAIL=replace-with-production-smtp-from-email
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10
