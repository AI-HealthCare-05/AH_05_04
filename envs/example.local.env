# docker
DOCKER_USER=ozcodingschool
DOCKER_REPOSITORY=ai-health

# fastapi
ENV=local
APP_VERSION=v1.0.0
SECRET_KEY=oz-codingschool-AI-health260127!@
COOKIE_DOMAIN=localhost

# ai-worker
AI_WORKER_VERSION=v1.0.0

# db
DB_HOST=mysql
DB_PORT=3306
DB_EXPOSE_PORT=3306
DB_USER=app_user
DB_PASSWORD=db_password
DB_ROOT_PASSWORD=root_password
DB_NAME=five_pills
SQLALCHEMY_ECHO=false

# openai (guide_ai / chat_ai)
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# CORS - 팀 로컬 개발 기준 Frontend origin
CORS_ALLOWED_ORIGINS=http://localhost:5173

# clova ocr
CLOVA_OCR_INVOKE_URL=https://example.apigw.ntruss.com/custom/v1/example/general
CLOVA_OCR_SECRET=your-clova-ocr-secret
CLOVA_OCR_TIMEOUT_SECONDS=20
