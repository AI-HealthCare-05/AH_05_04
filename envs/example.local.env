# ============================================================
# Docker image
# ============================================================

# 로컬에서 Docker image 이름을 만들 때 사용합니다.
DOCKER_USER=replace-with-local-registry-user
DOCKER_REPOSITORY=replace-with-local-image-repository


# ============================================================
# FastAPI
# ============================================================

ENV=local
APP_VERSION=local-dev

# 실제 값은 로컬 envs/.local.env에서만 설정합니다.
# 저장소에는 실제 secret을 기록하지 않습니다.
SECRET_KEY=replace-with-random-local-secret-at-least-32-characters

COOKIE_DOMAIN=localhost
TIMEZONE=Asia/Seoul

# 팀 로컬 개발 기준 Frontend origin입니다.
# 여러 origin은 쉼표로 구분합니다.
CORS_ALLOWED_ORIGINS=http://localhost:5173


# ============================================================
# AI Worker
# ============================================================

AI_WORKER_VERSION=v1.0.0


# ============================================================
# PostgreSQL
# ============================================================

# Backend가 Docker Compose 내부에서 실행되므로
# Docker Compose의 PostgreSQL 서비스명인 postgres를 사용합니다.
DB_HOST=postgres

# 컨테이너 내부 PostgreSQL 포트입니다.
DB_PORT=5432

# 개발자 PC에 공개할 PostgreSQL 포트입니다.
# 로컬 PC에서 직접 접속할 때 localhost:5432를 사용합니다.
DB_EXPOSE_PORT=5432

DB_USER=app_user

# 실제 값은 로컬 envs/.local.env에서만 설정합니다.
DB_PASSWORD=replace-with-local-db-password

DB_NAME=five_pills

# SQLAlchemy SQL 출력 여부입니다.
# 의료정보가 포함된 SQL parameter가 로그에 노출되지 않도록 false를 유지합니다.
SQLALCHEMY_ECHO=false

# DB 연결 제한 시간(초)
DB_CONNECT_TIMEOUT=5

# 애플리케이션 DB connection pool 최대 크기
DB_CONNECTION_POOL_MAXSIZE=10


# ============================================================
# Redis
# ============================================================

REDIS_PORT=6379


# ============================================================
# OpenAI - Guide / Chat
# ============================================================

# 실제 API Key는 로컬 envs/.local.env에서만 설정합니다.
OPENAI_API_KEY=replace-with-openai-api-key

OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=20


# ============================================================
# CLOVA OCR
# ============================================================

# 예시 URL이며 실제 endpoint를 저장소에 커밋하지 않습니다.
CLOVA_OCR_INVOKE_URL=https://example.apigw.ntruss.com/custom/v1/example/general

# 실제 Secret은 로컬 envs/.local.env에서만 설정합니다.
CLOVA_OCR_SECRET=replace-with-clova-ocr-secret

CLOVA_OCR_TIMEOUT_SECONDS=20
# 기본값은 false입니다.
# 비식별 합성 데이터로 LLM 구조화를 검증할 때만 true로 변경합니다.
OCR_STRUCTURE_LLM_ENABLED=false
OCR_STRUCTURE_MODEL=gpt-4o-mini
OCR_STRUCTURE_TIMEOUT_SECONDS=30
