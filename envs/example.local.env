# ============================================================
# Docker image
# ============================================================

# 로컬에서 Docker image 이름을 만들 때 사용합니다.
DOCKER_USER=replace-with-local-registry-user
DOCKER_REPOSITORY=replace-with-local-image-repository


# ============================================================
# FastAPI
# ============================================================

ENV=local
APP_VERSION=local-dev

# 승인된 local-live-full 검증을 실행할 때만 true로 변경합니다.
RELEASE_VALIDATION_ALLOWED=false

# 실제 값은 로컬 envs/.local.env에서만 설정합니다.
# 저장소에는 실제 secret을 기록하지 않습니다.
SECRET_KEY=replace-with-random-local-secret-at-least-32-characters

# idempotency-v1.md: 서버 재시작·여러 Backend 인스턴스 사이에서 같은 값이어야 합니다.
IDEMPOTENCY_HMAC_KEY=replace-with-random-local-idempotency-hmac-key-at-least-32-characters

# SYNC_MUTATION response_body_snapshot 암호화 키(Fernet). 코드 기본값과 동일한 값이라
# 실제로는 생략해도 되지만, 실제 값 설정 위치를 보여주기 위해 명시합니다. 알고리즘·키 관리는
# 아직 Privacy·Security 리뷰 대상입니다(#311).
IDEMPOTENCY_SNAPSHOT_ENCRYPTION_KEY=MDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDA=

# 위 key와 반드시 함께 관리하는 버전 식별자입니다. key를 교체할 때는 이 값도 v2, v3처럼
# 함께 올려야 하며, 그렇지 않으면 활성 version이 retired key의 version과 겹쳐 기동이
# 거부됩니다(envs/example.prod.env 참고).
IDEMPOTENCY_SNAPSHOT_ENCRYPTION_KEY_VERSION=v1

COOKIE_DOMAIN=localhost
TIMEZONE=Asia/Seoul

# 팀 로컬 개발 기준 Frontend origin입니다.
# 여러 origin은 쉼표로 구분합니다.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# backend/app/Dockerfile 기준 컨테이너 내부 WORKDIR(/app)에 맞춘 절대 경로입니다.
# 로컬에서 Docker 없이 직접 실행할 때는 코드 기본값(저장소 루트의 uploads/)을 사용합니다.
STORAGE_DIR=/app/uploads/medical_documents


# ============================================================
# AI Worker
# ============================================================

AI_WORKER_VERSION=v1.0.0


# ============================================================
# PostgreSQL
# ============================================================

# Backend가 Docker Compose 내부에서 실행되므로
# Docker Compose의 PostgreSQL 서비스명인 postgres를 사용합니다.
DB_HOST=postgres

# 컨테이너 내부 PostgreSQL 포트입니다.
DB_PORT=5432

# 개발자 PC에 공개할 PostgreSQL 포트입니다.
# 로컬 PC에서 직접 접속할 때 localhost:5432를 사용합니다.
DB_EXPOSE_PORT=5432

DB_USER=app_user

# 실제 값은 로컬 envs/.local.env에서만 설정합니다.
DB_PASSWORD=replace-with-local-db-password

DB_NAME=five_pills

# SQLAlchemy SQL 출력 여부입니다.
# 의료정보가 포함된 SQL parameter가 로그에 노출되지 않도록 false를 유지합니다.
SQLALCHEMY_ECHO=false

# DB 연결 제한 시간(초)
DB_CONNECT_TIMEOUT=5

# 애플리케이션 DB connection pool 최대 크기
DB_CONNECTION_POOL_MAXSIZE=10


# ============================================================
# Redis
# ============================================================

# 로컬 테스트용 Redis입니다. 운영 Redis 인증 기준은 example.prod.env를 따릅니다.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_STREAM_NAME=oryak:jobs
REDIS_DLQ_STREAM_NAME=oryak:jobs:dead-letter
REDIS_CONSUMER_GROUP=ai-workers
REDIS_CONSUMER_NAME=ai-worker-local
RECONCILER_CONSUMER_NAME=ai-worker-reconciler
REDIS_BLOCK_MS=5000


# ============================================================
# OpenAI - Guide / Chat
# ============================================================

# 실제 API Key는 로컬 envs/.local.env에서만 설정합니다.
OPENAI_API_KEY=replace-with-openai-api-key

OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=20

# 기본값은 false입니다. 비식별 합성 데이터로 최근 대화 문맥을 검증할 때만 true로 변경합니다.
CHAT_HISTORY_CONTEXT_ENABLED=false


# ============================================================
# CLOVA OCR
# ============================================================

# 예시 URL이며 실제 endpoint를 저장소에 커밋하지 않습니다.
CLOVA_OCR_INVOKE_URL=https://example.apigw.ntruss.com/custom/v1/example/general

# 실제 Secret은 로컬 envs/.local.env에서만 설정합니다.
CLOVA_OCR_SECRET=replace-with-clova-ocr-secret

CLOVA_OCR_TIMEOUT_SECONDS=20
# 기본값은 false입니다.
# 비식별 합성 데이터로 LLM 구조화를 검증할 때만 true로 변경합니다.
OCR_STRUCTURE_LLM_ENABLED=false
OCR_STRUCTURE_MODEL=gpt-4o-mini
OCR_STRUCTURE_TIMEOUT_SECONDS=30

# 기본값은 false입니다.
# RAG-11 UI·RAG-12 Preflight·E2E·외부 승인 전까지는 Candidate 조회·확정·거절 API를 공개하지 않습니다.
PUBLIC_TRACK_F_ENABLED=false
# Protected Retrieval remains opt-in; connection values are injected only in an approved environment.
PROTECTED_RETRIEVAL_ENABLED=false
